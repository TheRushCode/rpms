# Local Database Credentials
spring.datasource.url=jdbc:mysql://localhost:3306/kiran_academy_rpms?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=your_local_mysql_password_here

# Local Server Port (optional, default is 8080)
server.port=8080
